<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MarmitaTech PRO - Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *{margin:0;padding:0;box-sizing:border-box}
        body{font-family:'Inter',-apple-system,sans-serif;background:#0f1117;color:#e1e4e8;min-height:100vh}

        /* Header */
        .header{background:linear-gradient(135deg,#161b22,#1c2333);border-bottom:1px solid rgba(255,255,255,.06);padding:16px 32px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;backdrop-filter:blur(12px)}
        .header-brand{display:flex;align-items:center;gap:12px}
        .header-brand .logo{font-size:28px}
        .header-brand h1{font-size:20px;font-weight:700;background:linear-gradient(135deg,#58a6ff,#a371f7);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
        .header-brand span{font-size:11px;color:#8b949e;text-transform:uppercase;letter-spacing:1.5px}
        .header-actions a{color:#8b949e;text-decoration:none;font-size:13px;padding:8px 16px;border-radius:8px;transition:all .2s;border:1px solid transparent}
        .header-actions a:hover{color:#e1e4e8;background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.08)}

        /* Stats */
        .stats-bar{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;padding:24px 32px;max-width:1440px;margin:0 auto}
        .stat-card{background:linear-gradient(135deg,rgba(22,27,34,.8),rgba(28,35,51,.6));border:1px solid rgba(255,255,255,.06);border-radius:12px;padding:18px;display:flex;align-items:center;gap:14px;transition:transform .2s}
        .stat-card:hover{transform:translateY(-2px)}
        .stat-icon{width:44px;height:44px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
        .stat-icon.s-aberto{background:rgba(63,185,80,.12)}.stat-icon.s-cozinha{background:rgba(210,153,34,.12)}.stat-icon.s-entrega{background:rgba(88,166,255,.12)}.stat-icon.s-entregue{background:rgba(163,113,247,.12)}
        .stat-info h3{font-size:22px;font-weight:800}.stat-info p{font-size:11px;color:#8b949e;text-transform:uppercase;letter-spacing:.5px;margin-top:2px}

        /* Layout */
        .content-area{max-width:1440px;margin:0 auto;padding:0 32px 48px}
        .main-grid{display:grid;grid-template-columns:1fr 340px;gap:24px}

        /* Kanban */
        .kanban{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
        .kanban-col{background:rgba(22,27,34,.5);border:1px solid rgba(255,255,255,.06);border-radius:14px;min-height:400px;display:flex;flex-direction:column;transition:border-color .2s,box-shadow .2s}
        .kanban-col.drag-over{border-color:rgba(88,166,255,.4);box-shadow:0 0 20px rgba(88,166,255,.08)}
        .kanban-col-header{padding:16px 20px;border-bottom:1px solid rgba(255,255,255,.06);display:flex;align-items:center;gap:10px}
        .kanban-col-header .col-dot{width:10px;height:10px;border-radius:50%}
        .col-dot.aberto{background:#3fb950}.col-dot.cozinha{background:#d29922}.col-dot.entrega{background:#58a6ff}.col-dot.entregue{background:#a371f7}
        .kanban-col-header h3{font-size:14px;font-weight:600;flex:1}
        .kanban-col-header .col-count{font-size:11px;padding:2px 10px;border-radius:100px;background:rgba(255,255,255,.06);color:#8b949e;font-weight:600}
        .kanban-col-body{padding:12px;flex:1;display:flex;flex-direction:column;gap:10px;overflow-y:auto;max-height:60vh;min-height:80px;transition:background .2s}
        .kanban-col-body::-webkit-scrollbar{width:4px}.kanban-col-body::-webkit-scrollbar-thumb{background:rgba(255,255,255,.08);border-radius:4px}
        .kanban-col-body.drag-target{background:rgba(88,166,255,.04);border-radius:0 0 14px 14px}
        .kanban-card{background:linear-gradient(135deg,rgba(30,36,48,.9),rgba(22,27,34,.9));border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:16px;transition:all .25s;position:relative;overflow:hidden;cursor:grab}
        .kanban-card:hover{border-color:rgba(255,255,255,.15);transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.3)}
        .kanban-card.dragging{opacity:.4;transform:scale(.95);cursor:grabbing}
        .kanban-card .card-id{font-size:11px;color:#58a6ff;font-weight:700;margin-bottom:8px}
        .kanban-card .card-customer{font-size:14px;font-weight:600;margin-bottom:4px}
        .kanban-card .card-item{font-size:13px;color:#8b949e;display:flex;align-items:center;gap:6px;margin-bottom:4px}
        .kanban-card .card-price{font-size:13px;color:#3fb950;font-weight:700;margin-bottom:10px}
        .kanban-card .card-time{font-size:11px;color:#484f58;margin-bottom:12px}
        .advance-btn{width:100%;padding:8px 12px;border:none;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;font-family:'Inter',sans-serif;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:6px}
        .advance-btn.to-cozinha{background:rgba(210,153,34,.15);color:#d29922}.advance-btn.to-cozinha:hover{background:rgba(210,153,34,.3)}
        .advance-btn.to-entrega{background:rgba(88,166,255,.15);color:#58a6ff}.advance-btn.to-entrega:hover{background:rgba(88,166,255,.3)}
        .advance-btn.to-entregue{background:rgba(163,113,247,.15);color:#a371f7}.advance-btn.to-entregue:hover{background:rgba(163,113,247,.3)}
        .advance-btn.done{background:rgba(255,255,255,.03);color:#484f58;cursor:default;pointer-events:none}
        .kanban-empty{text-align:center;padding:32px 16px;color:#30363d;font-size:13px}
        .kanban-empty .empty-icon{font-size:32px;margin-bottom:8px;opacity:.5}
        .drop-indicator{height:4px;border-radius:2px;background:linear-gradient(90deg,#58a6ff,#a371f7);margin:4px 0;opacity:0;transition:opacity .15s}
        .drop-indicator.visible{opacity:1}

        /* Sidebar */
        .sidebar{display:flex;flex-direction:column;gap:20px}
        .card{background:linear-gradient(135deg,rgba(22,27,34,.9),rgba(28,35,51,.7));border:1px solid rgba(255,255,255,.06);border-radius:14px;overflow:hidden;transition:border-color .3s}
        .card:hover{border-color:rgba(255,255,255,.1)}
        .card-header{padding:16px 20px;border-bottom:1px solid rgba(255,255,255,.06);display:flex;align-items:center;gap:10px}
        .card-header h2{font-size:15px;font-weight:600}.card-header .badge{font-size:11px;padding:2px 10px;border-radius:100px;background:rgba(88,166,255,.12);color:#58a6ff;font-weight:600}
        .card-body{padding:20px}
        .form-group{margin-bottom:14px}
        .form-group label{display:block;font-size:11px;font-weight:600;color:#8b949e;margin-bottom:5px;text-transform:uppercase;letter-spacing:.5px}
        .form-group input,.form-group select{width:100%;padding:10px 12px;background:rgba(13,17,23,.6);border:1px solid rgba(255,255,255,.1);border-radius:8px;color:#e1e4e8;font-size:13px;font-family:'Inter',sans-serif;outline:none;transition:all .2s}
        .form-group input::placeholder{color:#484f58}
        .form-group input:focus,.form-group select:focus{border-color:#58a6ff;box-shadow:0 0 0 3px rgba(88,166,255,.1)}
        .form-group select option{background:#161b22;color:#e1e4e8}
        .btn{width:100%;padding:10px 16px;border:none;border-radius:8px;font-size:13px;font-weight:600;font-family:'Inter',sans-serif;cursor:pointer;transition:all .25s;display:flex;align-items:center;justify-content:center;gap:6px}
        .btn-primary{background:linear-gradient(135deg,#58a6ff,#388bfd);color:#fff;box-shadow:0 4px 14px rgba(88,166,255,.25)}
        .btn-primary:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(88,166,255,.35)}
        .btn-secondary{background:linear-gradient(135deg,#a371f7,#8957e5);color:#fff;box-shadow:0 4px 14px rgba(163,113,247,.25)}
        .btn-secondary:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(163,113,247,.35)}
        .items-list{list-style:none;max-height:180px;overflow-y:auto}
        .items-list::-webkit-scrollbar{width:4px}.items-list::-webkit-scrollbar-thumb{background:rgba(255,255,255,.1);border-radius:4px}
        .items-list li{padding:8px 12px;border-radius:6px;display:flex;justify-content:space-between;align-items:center;font-size:13px;transition:background .15s}
        .items-list li:hover{background:rgba(255,255,255,.03)}
        .items-list .item-name{font-weight:500}.items-list .item-meta{display:flex;align-items:center;gap:6px}
        .items-list .item-category{font-size:10px;padding:2px 7px;border-radius:100px;background:rgba(163,113,247,.1);color:#a371f7;font-weight:500}
        .items-list .item-price{font-size:12px;color:#3fb950;font-weight:600}

        /* Toast */
        .toast{position:fixed;bottom:24px;right:24px;padding:14px 24px;border-radius:10px;font-size:13px;font-weight:600;color:#fff;z-index:1000;transform:translateY(100px);opacity:0;transition:all .3s ease;pointer-events:none}
        .toast.show{transform:translateY(0);opacity:1}
        .toast.success{background:linear-gradient(135deg,#238636,#2ea043)}
        .toast.error{background:linear-gradient(135deg,#da3633,#f85149)}

        @keyframes fadeInUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
        .kanban-card{animation:fadeInUp .3s ease-out}
        @media(max-width:1100px){.kanban{grid-template-columns:repeat(2,1fr)}.main-grid{grid-template-columns:1fr}.stats-bar{grid-template-columns:repeat(2,1fr)}}
        @media(max-width:600px){.kanban{grid-template-columns:1fr}.stats-bar{grid-template-columns:1fr}.header{padding:12px 16px}.content-area{padding:0 16px 32px}}
    </style>
</head>
<body>

<%- include('partials/header') %>
<%- include('partials/stats') %>

<div class="content-area">
    <div class="main-grid">
        <div>
            <%- include('partials/kanban') %>
        </div>
        <%- include('partials/sidebar') %>
    </div>
</div>

<!-- Toast notification -->
<div class="toast" id="toast"></div>

<!-- Drag & Drop Script -->
<script>
(function() {
    const board = document.getElementById('kanban-board');
    if (!board) return;

    let draggedCard = null;
    let draggedId = null;

    // Toast helper
    function showToast(msg, type) {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.className = 'toast ' + type + ' show';
        setTimeout(() => t.classList.remove('show'), 2500);
    }

    // Update column counts & stats
    function updateCounts() {
        ['Aberto','Cozinha','Entrega','Entregue'].forEach(status => {
            const col = document.querySelector(`.kanban-col-body[data-status="${status}"]`);
            const cards = col.querySelectorAll('.kanban-card');
            const key = status.toLowerCase();
            // Column count badge
            const countEl = document.getElementById('count-' + key);
            if (countEl) countEl.textContent = cards.length;
            // Stats bar
            const statEl = document.getElementById('stat-' + key);
            if (statEl) statEl.textContent = cards.length;
            // Show/hide empty placeholder
            let empty = col.querySelector('.kanban-empty');
            if (cards.length === 0 && !empty) {
                empty = document.createElement('div');
                empty.className = 'kanban-empty';
                const emojis = {'Aberto':'📋','Cozinha':'🔥','Entrega':'🚚','Entregue':'✅'};
                empty.innerHTML = `<div class="empty-icon">${emojis[status]}</div><p>Nenhum pedido</p>`;
                col.appendChild(empty);
            } else if (cards.length > 0 && empty) {
                empty.remove();
            }
        });
    }

    // Update the advance button on a card after it moves
    function updateCardButton(card, newStatus) {
        const nextLabels = {'Aberto':'→ Enviar p/ Cozinha','Cozinha':'→ Saiu p/ Entrega','Entrega':'→ Marcar Entregue','Entregue':'✓ Concluído'};
        const nextClasses = {'Aberto':'to-cozinha','Cozinha':'to-entrega','Entrega':'to-entregue','Entregue':'done'};
        const orderId = card.dataset.orderId;
        const btnArea = card.querySelector('form, .advance-btn.done');
        if (btnArea) btnArea.remove();

        if (newStatus !== 'Entregue') {
            const form = document.createElement('form');
            form.action = `/orders/${orderId}/advance`;
            form.method = 'POST';
            form.style.margin = '0';
            const btn = document.createElement('button');
            btn.type = 'submit';
            btn.className = `advance-btn ${nextClasses[newStatus]}`;
            btn.textContent = nextLabels[newStatus];
            form.appendChild(btn);
            card.appendChild(form);
        } else {
            const div = document.createElement('div');
            div.className = 'advance-btn done';
            div.textContent = '✓ Concluído';
            card.appendChild(div);
        }
        card.dataset.status = newStatus;
    }

    // ─── Drag Events on Cards ───
    board.addEventListener('dragstart', (e) => {
        const card = e.target.closest('.kanban-card');
        if (!card) return;
        draggedCard = card;
        draggedId = card.dataset.orderId;
        card.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', draggedId);
    });

    board.addEventListener('dragend', (e) => {
        if (draggedCard) draggedCard.classList.remove('dragging');
        document.querySelectorAll('.kanban-col').forEach(c => c.classList.remove('drag-over'));
        document.querySelectorAll('.kanban-col-body').forEach(c => c.classList.remove('drag-target'));
        draggedCard = null;
        draggedId = null;
    });

    // ─── Drop Zone Events on Column Bodies ───
    board.addEventListener('dragover', (e) => {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        const colBody = e.target.closest('.kanban-col-body');
        const col = e.target.closest('.kanban-col');
        if (colBody) colBody.classList.add('drag-target');
        if (col) col.classList.add('drag-over');
    });

    board.addEventListener('dragleave', (e) => {
        const colBody = e.target.closest('.kanban-col-body');
        const col = e.target.closest('.kanban-col');
        if (colBody && !colBody.contains(e.relatedTarget)) colBody.classList.remove('drag-target');
        if (col && !col.contains(e.relatedTarget)) col.classList.remove('drag-over');
    });

    board.addEventListener('drop', async (e) => {
        e.preventDefault();
        const colBody = e.target.closest('.kanban-col-body');
        if (!colBody || !draggedCard) return;

        const newStatus = colBody.dataset.status;
        const oldStatus = draggedCard.dataset.status;

        if (newStatus === oldStatus) return;

        // Remove empty state if present
        const empty = colBody.querySelector('.kanban-empty');
        if (empty) empty.remove();

        // Move card in DOM
        colBody.appendChild(draggedCard);
        draggedCard.classList.remove('dragging');
        updateCardButton(draggedCard, newStatus);
        updateCounts();

        // Send to backend
        try {
            const res = await fetch(`/orders/${draggedId}/status`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: newStatus })
            });
            if (res.ok) {
                showToast(`Pedido #${draggedId}: ${oldStatus} → ${newStatus}`, 'success');
            } else {
                throw new Error('Falha ao atualizar');
            }
        } catch (err) {
            showToast('Erro ao mover pedido!', 'error');
            // Revert: move card back
            const origCol = document.querySelector(`.kanban-col-body[data-status="${oldStatus}"]`);
            if (origCol) origCol.appendChild(draggedCard);
            updateCardButton(draggedCard, oldStatus);
            updateCounts();
        }
    });
})();
</script>
</body>
</html>
