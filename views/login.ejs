<!DOCTYPE html>
<html>
<head>
    <title>MarmitaTech - Access</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; display: flex; flex-direction: column; align-items: center; background: #eef2f3; margin: 0; padding-top: 80px; }
        .container { background: #fff; width: 320px; padding: 25px; border-radius: 6px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 20px; text-align: center; }
        h2 { margin-top: 0; color: #333; font-size: 24px; }
        input { width: 90%; padding: 10px; margin: 10px 0; border: 1px solid #ccc; border-radius: 4px; }
        button { width: 100%; padding: 10px; background: #0066cc; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-size: 16px; margin-top: 10px; }
        button:hover { background: #005bb5; }
        hr { border: 0; height: 1px; background: #eee; margin: 25px 0; }
    </style>
</head>
<body>
    <div class="container">
        <h2>🥪 MarmitaTech</h2>
        <form action="/login" method="POST">
            <input type="text" name="username" placeholder="Usuário" required>
            <input type="password" name="password" placeholder="Senha" required>
            <button type="submit">Entrar no Sistema</button>
        </form>

        <hr>

        <h3 style="margin-top:0; color:#555; font-size: 16px;">Novo por aqui?</h3>
        <form action="/register" method="POST">
            <input type="text" name="username" placeholder="Criar Usuário" required>
            <input type="password" name="password" placeholder="Criar Senha" required>
            <button type="submit" style="background:#28a745;">Registrar Conta</button>
        </form>
    </div>
</body>
</html>
